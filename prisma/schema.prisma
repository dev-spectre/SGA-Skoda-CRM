generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                 Int            @id @default(autoincrement())
  name               String
  phone              String
  city               String         @default("")
  adname             String         @default("")
  branch             String         @default("")
  followUpDate1      DateTime?
  followUpDate2      DateTime?
  remark             String?
  status             String         @default("not_contacted")
  sheetRow           Int?
  sheetId            String?
  fingerprint        String?        @unique
  assignedConsultant String?
  testDrive          String?
  platform           String?
  source             String         @default("System")
  uploadedById       Int?
  uploadedAt         DateTime?
  notifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  isInvalidPhone     Boolean        @default(false)
  isBranchManual     Boolean        @default(false)
  hiddenBy           HiddenLead[]
  uploadedBy         User?          @relation("UserUploadedLeads", fields: [uploadedById], references: [id])
  activities         LeadActivity[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([branch])
  @@index([fingerprint])
  @@index([isInvalidPhone])
  @@index([isBranchManual])
}

model User {
  id                  Int            @id @default(autoincrement())
  username            String         @unique
  password            String
  role                String         @default("USER")
  assignedBranch      String?
  assignedPlatform    String?
  allowExternalUpload Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  hiddenLeads         HiddenLead[]
  uploadedLeads       Lead[]         @relation("UserUploadedLeads")
  activities          LeadActivity[]
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  userId    Int?
  username  String
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model HiddenLead {
  id        Int      @id @default(autoincrement())
  userId    Int
  leadId    Int
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId])
  @@index([userId])
  @@index([leadId])
}

model Settings {
  id                             Int       @id @default(1)
  googleAccessToken              String?
  googleRefreshToken             String?
  googleTokenExpiry              DateTime?
  googleAccountEmail             String?
  selectedSpreadsheetId          String?
  selectedSpreadsheetName        String?
  selectedSheetName              String?
  notificationInterval           Int       @default(5)
  backgroundNotificationsEnabled Boolean   @default(true)
  columnMapping                  String?
  notifiedPhones                 String?   @default("[]")
  lastSyncAt                     DateTime?
  updatedAt                      DateTime  @updatedAt
}

model PushSubscription {
  id             Int       @id @default(autoincrement())
  endpoint       String    @unique
  keys           String
  interval       Int       @default(5)
  deviceName     String?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Consultant {
  id        Int      @id @default(autoincrement())
  name      String
  branch    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branch])
  @@index([branch])
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  address   String   @default("")
  city      String   @default("")
  latitude  Float?
  longitude Float?
  radiusKm  Float    @default(50.0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([city])
  @@index([isActive])
}

model LocationCache {
  id            Int      @id @default(autoincrement())
  searchTerm    String   @unique
  canonicalName String
  district      String   @default("")
  state         String   @default("")
  latitude      Float
  longitude     Float
  source        String   @default("geocoder")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([searchTerm])
  @@index([canonicalName])
  @@index([state])
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  city          String    @default("")
  adname        String    @default("")
  branch        String    @default("")
  followUpDate1 DateTime?
  followUpDate2 DateTime?
  remark        String?
  status    String   @default("not_contacted")
  sheetRow  Int?
  sheetId   String?
  fingerprint String?   @unique
  assignedConsultant String?
  testDrive String?
  platform  String?
  source    String   @default("System")
  uploadedById Int?
  uploadedBy   User?   @relation(name: "UserUploadedLeads", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt DateTime?

  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hiddenBy   HiddenLead[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([status])
  @@index([branch])
  @@index([fingerprint])
}

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique
  password       String
  role           String       @default("USER") // "ADMIN" or "USER"
  assignedBranch String?      // Optional branch assignment, e.g., "coimbatore" or null for all branches
  assignedPlatform String?    // Optional platform assignment, e.g., "Meta" or null
  allowExternalUpload Boolean  @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  hiddenLeads    HiddenLead[]
  uploadedLeads  Lead[]        @relation(name: "UserUploadedLeads")
}

model HiddenLead {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, leadId])
  @@index([userId])
  @@index([leadId])
}

model Settings {
  id                    Int       @id @default(1)
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  googleAccountEmail    String?
  selectedSpreadsheetId String?
  selectedSpreadsheetName String?
  selectedSheetName     String?
  notificationInterval  Int       @default(5)
  backgroundNotificationsEnabled Boolean @default(true)
  columnMapping         String?
  notifiedPhones        String?   @default("[]")
  lastSyncAt            DateTime?
  updatedAt             DateTime  @updatedAt
}

model PushSubscription {
  id             Int       @id @default(autoincrement())
  endpoint       String    @unique
  keys           String
  interval       Int       @default(5)
  deviceName     String?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Consultant {
  id        Int      @id @default(autoincrement())
  name      String
  branch    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branch])
  @@index([branch])
}


generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email         String    @default("")
  city          String    @default("")
  adname        String    @default("")
  branch        String    @default("")
  followUpDate1 DateTime?
  followUpDate2 DateTime?
  remark        String?
  status    String   @default("created")
  sheetRow  Int?
  sheetId   String?
  fingerprint String?   @unique

  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([fingerprint])
}

model Settings {
  id                    Int       @id @default(1)
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiry     DateTime?
  googleAccountEmail    String?
  selectedSpreadsheetId String?
  selectedSpreadsheetName String?
  selectedSheetName     String?
  notificationInterval  Int       @default(5)
  backgroundNotificationsEnabled Boolean @default(true)
  columnMapping         String?
  notifiedPhones        String?   @default("[]")
  lastSyncAt            DateTime?
  updatedAt             DateTime  @updatedAt
}

model PushSubscription {
  id             Int       @id @default(autoincrement())
  endpoint       String    @unique
  keys           String
  interval       Int       @default(5)
  deviceName     String?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
